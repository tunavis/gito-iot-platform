  "receive_window": {
    "class": null,
    "class_note": "The IWM manual has no Class row, unlike the RFM's. Class A is the safe operational assumption for a 10-year battery meter, but it is not documented, so it is not asserted here.",
    "post_join_seconds": 120,
    "post_join_note": "The ~2-minute CONFIGURE window after join is the only period with frequent uplinks, so the only period with frequent RX slots. It is the intended window for provisioning (0x14, 0x16, 0x1A, 0x26).",
    "operational_interval_seconds": 43200,
    "operational_interval_note": "12 hours, configurable over NFC only — there is no downlink command to change it. A downlink queued in OPERATIONAL state may wait a full interval before the device opens an RX window."
