# ============================================================================
# GITO IOT PLATFORM - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains secrets
# ============================================================================

# Database
DB_PASSWORD=your-secure-db-password-here
DATABASE_URL=postgresql://gito:your-secure-db-password-here@postgres:5432/gito

# Redis / KeyDB
REDIS_URL=redis://keydb:6379/0

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-xxxxxxxxxxxxxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Outbound credential encryption (network-server tokens, broker passwords)
# This is the ONE variable docker-compose.yml gives no default for, and that is
# deliberate: a default encryption key would silently encrypt real credentials
# with a value that is in the repo. So it must be set here, and a fresh clone
# with no .env leaves it empty — `_fernet()` then raises SecretKeyMissing the
# first time an encrypted column is touched, which is a confusing failure a long
# way from its cause. Generate your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left EMPTY on purpose. A placeholder string here is not a valid Fernet key, so
# copying this file unedited would fail inside Fernet() as a malformed-key error
# — just as far from the cause, and without the instructions. Empty routes to
# `_fernet()`'s missing-key error instead, which prints the command above.
SECRET_ENCRYPTION_KEY=

# MQTT / Mosquitto
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=your-mqtt-admin-password

# FastAPI Backend
FASTAPI_URL=http://api:8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Next.js Frontend
NEXT_PUBLIC_API_URL=/api
NODE_ENV=development

# ChirpStack (Phase 3)
CHIRPSTACK_API_URL=http://chirpstack:8090
CHIRPSTACK_TENANT_ID=your-chirpstack-tenant-uuid
CHIRPSTACK_API_KEY=your-chirpstack-api-key

# Notifications (Phase 3.2e)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@gito-iot.com
SMTP_TLS=true
NOTIFICATION_THROTTLE_MINUTES=1
FRONTEND_URL=http://localhost:3000

# Observability (Phase 4)
PROMETHEUS_ENABLED=false
GRAFANA_URL=http://grafana:3000
LOKI_URL=http://loki:3100

# MCP server (F1)
# Default OFF: H1 ships an internal-facing demo, not a public assistant beta.
# When false the /mcp route is not mounted at all (404), rather than mounted and
# refusing.
MCP_ENABLED=false
# Pinned deliberately and asserted against the installed SDK at startup — a
# mismatch fails the boot rather than silently negotiating a different protocol.
MCP_PROTOCOL_VERSION=2026-07-28
# Hosts accepted in the Host header. The SDK does DNS-rebinding protection and
# trusts only 127.0.0.1 by default, which 421s every request arriving through
# nginx under a real hostname — list each host clients actually connect to.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
